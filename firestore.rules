rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Climate Education Game - Student Progress by Management Code
    match /climate_students/{manageCode} {
      allow read, write: if true;
    }

    // Climate Action Certifications & Pledges Board
    match /climate_certifications/{certId} {
      allow read, write: if true;
    }
  }
}
